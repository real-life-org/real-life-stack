{
  "name": "@real-life-stack/toolkit",
  "version": "0.3.0",
  "description": "React UI toolkit: the app frame (AppFrame, RoutedAppFrame), the module host, seven modules (feed, list, kanban, calendar, map, graph, resonance), item preview and detail, composer, hooks. Styles from ./styles/globals.css; map engine from ./maplibre or ./leaflet; router glue from ./router.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/real-life-org/real-life-stack.git",
    "directory": "packages/toolkit"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./leaflet": {
      "types": "./dist/leaflet.d.ts",
      "development": "./src/leaflet.ts",
      "import": "./dist/leaflet.js"
    },
    "./maplibre": {
      "types": "./dist/maplibre.d.ts",
      "development": "./src/maplibre.ts",
      "import": "./dist/maplibre.js"
    },
    "./styles/globals.css": "./src/styles/globals.css",
    "./router": {
      "types": "./dist/router.d.ts",
      "development": "./src/router.tsx",
      "import": "./dist/router.js"
    }
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@real-life-stack/data-interface": "workspace:*",
    "@tanstack/react-virtual": "3.14.6",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@real-life-stack/mock-connector": "workspace:*",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@tailwindcss/vite": "^4.1.0",
    "@types/leaflet": "^1.9.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^26.1.0",
    "maplibre-gl": "^5.24.0",
    "react-router-dom": "^7.1.1",
    "storybook": "^10.1.11",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "leaflet": "^1.9.0",
    "maplibre-gl": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./leaflet": {
        "types": "./dist/leaflet.d.ts",
        "import": "./dist/leaflet.js"
      },
      "./maplibre": {
        "types": "./dist/maplibre.d.ts",
        "import": "./dist/maplibre.js"
      },
      "./styles/globals.css": "./src/styles/globals.css",
      "./router": {
        "types": "./dist/router.d.ts",
        "import": "./dist/router.js"
      }
    }
  }
}
