---
import Default from '@astrojs/starlight/components/Footer.astro'
import info from '../../public/build-info.json'
const de = (Astro.currentLocale ?? 'de') === 'de'
const prefix = de ? '' : `/${Astro.currentLocale}`
const family = de ? 'Dieser Stack ist Teil des Real Life Projekts' : 'This stack is part of the Real Life project'
---
<Default><slot /></Default>
<aside class="rl-family" aria-label={family}>
  <strong>{family}</strong>
  <nav>
    <a href="https://real-life.org/">{de ? 'Gesamtbild' : 'Big picture'}</a>
    <a href="https://reallife.network/">Real Life Network</a>
    <a href="https://rltp.real-life.org/">Trust Protocol</a>
    <a href="https://github.com/real-life-org/real-life-stack">GitHub</a>
    <a href={`${prefix}/datenschutz/`}>{de ? 'Datenschutz' : 'Privacy'}</a>
  </nav>
  <small>App {info.app} · Toolkit {info.toolkit} · <code>{info.commit.slice(0, 8)}</code>{info.dirty ? (de ? ' mit lokalen Änderungen' : ' with local changes') : ''}</small>
</aside>
