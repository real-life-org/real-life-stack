---
import { translations, type TranslatedLanguage } from '../i18n/landing'
import Icon from './Icon.astro'
interface Props { lang: TranslatedLanguage }
const { lang } = Astro.props
const t = translations[lang] ?? translations.en
const prefix = lang === 'de' ? '' : `/${lang}`
const de = lang === 'de'
// Die vier Wege ins Handbuch (Plan 22.09.2026). Deutsch und Englisch; die
// übrigen Sprachen lesen die englische Fassung, bis das Handbuch sie hat.
const ways = de
  ? [
      { title: 'Erste App bauen', text: 'In zehn Minuten eine eigene App auf dem Rahmen: Connector, Router, Rahmen, fertig.', href: '/handbuch/erste-app/', soon: false, icon: 'rocket', tone: 'orange' },
      { title: 'Mit einem Agenten arbeiten', text: 'Einstiege, Auftragsform, Regeln und Prüfungen für Coding-Agents — dieselben Verträge wie für Menschen.', href: '/handbuch/agenten/', soon: false, icon: 'bot', tone: 'purple' },
      { title: 'Am Stack mitbauen', text: 'Entwicklungsumgebung, Spec, Wächter, Review. So wird ein Beitrag zum PR.', href: '/handbuch/entwickeln/', soon: false, icon: 'wrench', tone: 'blue' },
      { title: 'Eine Instanz betreiben', text: 'Die fertige App unter eigenem Namen und eigener Domain für eine Community.', href: '/handbuch/', soon: true, icon: 'server', tone: 'green' },
    ]
  : [
      { title: 'Build a first app', text: 'Your own app on the frame in ten minutes: connector, router, frame, done. German for now.', href: '/handbuch/erste-app/', soon: false, icon: 'rocket', tone: 'orange' },
      { title: 'Work with an agent', text: 'Entry points, task shape, rules and checks for coding agents — the same contracts as for people. German for now.', href: '/handbuch/agenten/', soon: false, icon: 'bot', tone: 'purple' },
      { title: 'Contribute to the stack', text: 'Dev environment, spec, guards, review. How a contribution becomes a PR. German for now.', href: '/handbuch/entwickeln/', soon: false, icon: 'wrench', tone: 'blue' },
      { title: 'Run an instance', text: 'The finished app under your own name and domain for a community.', href: `${prefix}/handbuch/`, soon: true, icon: 'server', tone: 'green' },
    ] as const
const waysTitle = de ? 'Vier Wege hinein' : 'Four ways in'
const waysIntro = de ? 'Je nachdem, was du vorhast. Jede Seite des Handbuchs gehört genau einem Weg.' : 'Depending on what you are up to. Every handbook page belongs to exactly one way.'
const soon = de ? 'folgt' : 'soon'
---
<div class="rl-landing">
  <section class="rl-ways" id="wege">
    <h2>{waysTitle}</h2>
    <p>{waysIntro}</p>
    <div class="rl-cards">
      {ways.map((w) => (
        <a class:list={['rl-card', { soon: w.soon }]} href={w.href}>
          <Icon name={w.icon} tone={w.tone} />
          <strong>{w.title}{w.soon ? ` · ${soon}` : ''}</strong>
          <span>{w.text}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="rl-section" id="module">
    <div>
      <div class="rl-badge">{t.modules.badge}</div>
      <h2>{t.modules.title}</h2>
      <p>{t.modules.p1}</p>
      <p>{t.modules.p2}</p>
    </div>
    <div class="rl-cards">
      <div class="rl-card centered"><Icon name="map" tone="green" /><strong>{t.modules.map}</strong><span>{t.modules.mapDesc}</span></div>
      <div class="rl-card centered"><Icon name="calendar" tone="blue" /><strong>{t.modules.calendar}</strong><span>{t.modules.calendarDesc}</span></div>
      <div class="rl-card centered"><Icon name="store" tone="purple" /><strong>{t.modules.marketplace}</strong><span>{t.modules.marketplaceDesc}</span></div>
      <div class="rl-card centered"><Icon name="message-square" tone="orange" /><strong>{t.modules.feed}</strong><span>{t.modules.feedDesc}</span></div>
    </div>
  </section>

  <section class="rl-section flip" id="schnittstelle" style="--rl-accent: var(--rl-blue)">
    <div>
      <div class="rl-badge">{t.dataInterface.badge}</div>
      <h2>{t.dataInterface.title}</h2>
      <p>{t.dataInterface.p1}</p>
      <p>{t.dataInterface.p2}</p>
    </div>
    <div class="rl-list">
      <div><Icon name="users" tone="blue" /><div><strong>{t.dataInterface.groups}</strong><span>{t.dataInterface.groupsDesc}</span></div></div>
      <div><Icon name="calendar" tone="blue" /><div><strong>{t.dataInterface.events}</strong><span>{t.dataInterface.eventsDesc}</span></div></div>
      <div><Icon name="shield" tone="blue" /><div><strong>{t.dataInterface.trust}</strong><span>{t.dataInterface.trustDesc}</span></div></div>
    </div>
  </section>

  <section class="rl-section" id="connectoren" style="--rl-accent: var(--rl-green)">
    <div>
      <div class="rl-badge">{t.connectors.badge}</div>
      <h2>{t.connectors.title}</h2>
      <p>{t.connectors.p1}</p>
      <p>{t.connectors.p2}</p>
    </div>
    <div class="rl-cards three">
      {([
        ['REST', t.connectors.restDesc, 'globe', 'blue'], ['GraphQL', t.connectors.graphqlDesc, 'waypoints', 'purple'], ['Local-first', t.connectors.localDesc, 'hard-drive', 'green'],
        ['P2P', t.connectors.p2pDesc, 'wot', 'orange'], ['E2EE', t.connectors.e2eeDesc, 'lock', 'red'], ['DIDs', t.connectors.didsDesc, 'fingerprint', 'teal'],
      ] as const).map(([name, desc, icon, tone]) => (
        <div class="rl-card compact"><Icon name={icon} tone={tone} tile={false} /><div><strong>{name}</strong><span>{desc}</span></div></div>
      ))}
    </div>
  </section>
</div>
