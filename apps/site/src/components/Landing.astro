---
import { translations, type TranslatedLanguage } from '../i18n/landing'
import Icon from './Icon.astro'
import { stackDiagramHtml } from '../lib/stack-diagram'
import type { IconName } from './icons'
interface Props { lang: TranslatedLanguage }
const { lang } = Astro.props
const t = translations[lang] ?? translations.en
const prefix = lang === 'de' ? '' : `/${lang}`
const de = lang === 'de'
// Die vier Wege ins Handbuch (Plan 22.09.2026). Deutsch und Englisch; die
// übrigen Sprachen lesen die englische Fassung, bis das Handbuch sie hat.
type Tone = 'green' | 'blue' | 'orange' | 'purple' | 'red' | 'teal'
const ways: { title: string; text: string; href: string; soon: boolean; icon: IconName; tone: Tone }[] = de
  ? [
      { title: 'Eine Instanz betreiben', text: 'Die fertige App unter eigenem Namen und eigener Domain: Image, Konfiguration, Branding, Updates.', href: `${prefix}/handbuch/instanz/`, soon: false, icon: 'server', tone: 'green' },
      { title: 'Eine eigene App bauen', text: 'In zehn Minuten eine eigene App auf dem Rahmen: Connector, Router, Rahmen, fertig.', href: `${prefix}/handbuch/erste-app/`, soon: false, icon: 'rocket', tone: 'orange' },
      { title: 'Den Stack erweitern', text: 'Entwicklungsumgebung, Spec, Wächter, Review. So wird ein Beitrag zum PR.', href: `${prefix}/handbuch/entwickeln/`, soon: false, icon: 'wrench', tone: 'blue' },
      { title: 'Mit Agenten arbeiten', text: 'Einstiege, Auftragsform, Regeln und Prüfungen für Coding-Agents.', href: `${prefix}/handbuch/agenten/`, soon: false, icon: 'bot', tone: 'purple' },
    ]
  : [
      { title: 'Run an instance', text: 'The finished app under your own name and domain: image, configuration, branding, updates.', href: `${prefix}/handbuch/instanz/`, soon: false, icon: 'server', tone: 'green' },
      { title: 'Build your own app', text: 'Your own app on the frame in ten minutes: connector, router, frame, done.', href: `${prefix}/handbuch/erste-app/`, soon: false, icon: 'rocket', tone: 'orange' },
      { title: 'Extend the stack', text: 'Dev environment, spec, guards, review. How a contribution becomes a PR.', href: `${prefix}/handbuch/entwickeln/`, soon: false, icon: 'wrench', tone: 'blue' },
      { title: 'Work with agents', text: 'Entry points, task shape, rules and checks for coding agents.', href: `${prefix}/handbuch/agenten/`, soon: false, icon: 'bot', tone: 'purple' },
    ]
// Die Modulkarten zeigen auf ihre Storybook-Seite; Kanban statt Marktplatz, weil der Marktplatz ein Modul der Netzwerk-App ist, kein Toolkit-Modul.
const m = (key: 'kanban' | 'kanbanDesc' | 'more') => t.modules[key] ?? translations.en.modules[key] ?? ''
const modules: { name: string; desc: string; icon: IconName; tone: Tone; story: string }[] = [
  { name: t.modules.map, desc: t.modules.mapDesc, icon: 'map', tone: 'green', story: 'rls-modules-map--docs' },
  { name: t.modules.calendar, desc: t.modules.calendarDesc, icon: 'calendar', tone: 'blue', story: 'rls-modules-calendar--docs' },
  { name: m('kanban'), desc: m('kanbanDesc'), icon: 'kanban', tone: 'purple', story: 'rls-modules-kanban--docs' },
  { name: t.modules.feed, desc: t.modules.feedDesc, icon: 'message-square', tone: 'orange', story: 'rls-modules-feed--docs' },
]
const waysTitle = de ? 'Loslegen' : 'Get started'
const waysIntro = de ? 'Vier Wege ins Handbuch, je nachdem, was du vorhast.' : 'Four ways into the handbook, depending on what you have in mind.'
const waysAll = de ? 'Ganzes Handbuch' : 'Full handbook'
// Die Abschnitte tragen Namen und Farbe ihrer Schicht im Bild darüber, damit Bild und Seite sich decken.
const layer = { toolkit: 'Toolkit', interface: 'Data Interface', connectors: de ? 'Connectoren' : 'Connectors' }
// Schluss der Seite: zurück zu den beiden Einstiegen aus dem Hero.
const outro = de
  ? { title: 'Sieh es dir in Aktion an', text: 'Die Demo zeigt die Referenz-App mit allen Modulen. Das Handbuch führt dich von dort zur eigenen Instanz oder App.', demo: t.hero.demo, handbook: 'Handbuch' }
  : { title: 'See it in action', text: 'The demo shows the reference app with every module. From there, the handbook takes you to your own instance or app.', demo: t.hero.demo, handbook: 'Handbook' }
// Der Stack als eigener Abschnitt: vier Schichten, zugleich die Karte der drei Abschnitte darunter.
// Deutsch und Englisch; die übrigen Sprachen lesen die englische Fassung wie bei den Wegen.
const stack = de
  ? { badge: 'Aufbau', title: 'Vier Schichten, jede austauschbar', p1: 'Eine App setzt sich aus Modulen des Toolkits zusammen. Die Module lesen und schreiben nur über das Data Interface. Ein Connector verbindet es mit einer Datenquelle: Web of Trust, Supabase oder einer eigenen.', p2: 'Jede Schicht lässt sich austauschen, ohne die anderen anzufassen. Die Abschnitte darunter gehen sie von oben nach unten durch.' }
  : { badge: 'Architecture', title: 'Four layers, each replaceable', p1: 'An app is composed of toolkit modules. The modules read and write only through the Data Interface. A connector links it to a data source: Web of Trust, Supabase or your own.', p2: 'Each layer can be replaced without touching the others. The sections below walk through them from top to bottom.' }
const soon = de ? 'folgt' : 'soon'
---
<div class="rl-landing not-content">
  <section class="rl-ways" id="wege">
    <div class="rl-ways-head">
      <div>
        <h2>{waysTitle}</h2>
        <p>{waysIntro}</p>
      </div>
      <a class="rl-more-link" href={`${prefix}/handbuch/`}>{waysAll} →</a>
    </div>
    <div class="rl-cards">
      {ways.map((w) => (
        <a class:list={['rl-card', { soon: w.soon }]} href={w.href}>
          <Icon name={w.icon} tone={w.tone} />
          <strong>{w.title}{w.soon ? ` · ${soon}` : ''}</strong>
          <span>{w.text}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="rl-section flip" id="aufbau">
    <div>
      <div class="rl-badge">{stack.badge}</div>
      <h2>{stack.title}</h2>
      <p>{stack.p1}</p>
      <p>{stack.p2}</p>
    </div>
    <Fragment set:html={stackDiagramHtml(lang, prefix)} />
  </section>

  <section class="rl-section" id="module" style="--rl-accent: var(--rl-purple)">
    <div>
      <div class="rl-badge">{layer.toolkit}</div>
      <h2>{t.modules.title}</h2>
      <p>{t.modules.p1}</p>
      <p>{t.modules.p2}</p>
    </div>
    <div>
      <div class="rl-cards">
        {modules.map((m) => (
          <a class="rl-card centered" href={`https://real-life-stack.de/storybook/?path=/docs/${m.story}`}>
            <Icon name={m.icon} tone={m.tone} />
            <strong>{m.name}</strong><span>{m.desc}</span>
          </a>
        ))}
      </div>
      <p class="rl-more"><a class="rl-more-link" href="https://real-life-stack.de/storybook/?path=/docs/rls-start-read-me-first--docs">{m('more')} →</a></p>
    </div>
  </section>

  <section class="rl-section flip" id="schnittstelle" style="--rl-accent: var(--rl-blue)">
    <div>
      <div class="rl-badge">{layer.interface}</div>
      <h2>{t.dataInterface.title}</h2>
      <p>{t.dataInterface.p1}</p>
      <p>{t.dataInterface.p2}</p>
    </div>
    <div class="rl-cards one">
      <div class="rl-card row"><Icon name="layers" tone="orange" /><div><strong>{t.dataInterface.items}</strong><span>{t.dataInterface.itemsDesc}</span></div></div>
      <div class="rl-card row"><Icon name="users" tone="purple" /><div><strong>{t.dataInterface.spaces}</strong><span>{t.dataInterface.spacesDesc}</span></div></div>
      <div class="rl-card row"><Icon name="shield-check" tone="teal" /><div><strong>{t.dataInterface.capabilities}</strong><span>{t.dataInterface.capabilitiesDesc}</span></div></div>
    </div>
  </section>

  <section class="rl-section" id="connectoren" style="--rl-accent: var(--rl-green)">
    <div>
      <div class="rl-badge">{layer.connectors}</div>
      <h2>{t.connectors.title}</h2>
      <p>{t.connectors.p1}</p>
      <p>{t.connectors.p2}</p>
    </div>
    <div class="rl-cards one">
      {([
        [t.connectors.wot, t.connectors.wotDesc, 'wot', 'orange', 'https://web-of-trust.de/', 'npm'],
        [t.connectors.supabase, t.connectors.supabaseDesc, 'database', 'green', 'https://www.npmjs.com/package/@real-life-stack/supabase-connector', 'npm'],
        [t.connectors.own, t.connectors.ownDesc, 'plug', 'blue', 'https://github.com/real-life-org/real-life-stack/blob/master/docs/spec/03-capabilities.md', 'Spec'],
      ] as const).map(([name, desc, icon, tone, href, tag]) => (
        <a class:list={['rl-card row', { open: tag === 'Spec' }]} href={href}><Icon name={icon} tone={tone} /><div><strong>{name}</strong><span>{desc}</span></div><em class="rl-tag">{tag}</em></a>
      ))}
    </div>
  </section>

  <section class="rl-outro">
    <div>
      <h2>{outro.title}</h2>
      <p>{outro.text}</p>
    </div>
    <div class="rl-actions">
      <a class="rl-btn primary" href="https://real-life-stack.de/app/">{outro.demo} →</a>
      <a class="rl-btn" href={`${prefix}/handbuch/`}>{outro.handbook}</a>
    </div>
  </section>
</div>

<script>
  import '../scripts/story-frames'
</script>
