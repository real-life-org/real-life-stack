---
import { translations, type TranslatedLanguage } from '../i18n/landing'
import Icon from './Icon.astro'
import type { IconName } from './icons'
interface Props { lang: TranslatedLanguage }
const { lang } = Astro.props
const t = translations[lang] ?? translations.en
const prefix = lang === 'de' ? '' : `/${lang}`
const de = lang === 'de'
// Die vier Wege ins Handbuch (Plan 22.09.2026). Deutsch und Englisch; die
// übrigen Sprachen lesen die englische Fassung, bis das Handbuch sie hat.
type Tone = 'green' | 'blue' | 'orange' | 'purple' | 'red' | 'teal'
const ways: { title: string; text: string; href: string; soon: boolean; icon: IconName; tone: Tone }[] = de
  ? [
      { title: 'Erste App bauen', text: 'In zehn Minuten eine eigene App auf dem Rahmen: Connector, Router, Rahmen, fertig.', href: `${prefix}/handbuch/erste-app/`, soon: false, icon: 'rocket', tone: 'orange' },
      { title: 'Mit einem Agenten arbeiten', text: 'Einstiege, Auftragsform, Regeln und Prüfungen für Coding-Agents.', href: `${prefix}/handbuch/agenten/`, soon: false, icon: 'bot', tone: 'purple' },
      { title: 'Am Stack mitbauen', text: 'Entwicklungsumgebung, Spec, Wächter, Review. So wird ein Beitrag zum PR.', href: `${prefix}/handbuch/entwickeln/`, soon: false, icon: 'wrench', tone: 'blue' },
      { title: 'Eine Instanz betreiben', text: 'Die fertige App unter eigenem Namen und eigener Domain: Image, Konfiguration, Branding, Updates.', href: `${prefix}/handbuch/instanz/`, soon: false, icon: 'server', tone: 'green' },
    ]
  : [
      { title: 'Build a first app', text: 'Your own app on the frame in ten minutes: connector, router, frame, done.', href: `${prefix}/handbuch/erste-app/`, soon: false, icon: 'rocket', tone: 'orange' },
      { title: 'Work with an agent', text: 'Entry points, task shape, rules and checks for coding agents.', href: `${prefix}/handbuch/agenten/`, soon: false, icon: 'bot', tone: 'purple' },
      { title: 'Contribute to the stack', text: 'Dev environment, spec, guards, review. How a contribution becomes a PR.', href: `${prefix}/handbuch/entwickeln/`, soon: false, icon: 'wrench', tone: 'blue' },
      { title: 'Run an instance', text: 'The finished app under your own name and domain: image, configuration, branding, updates.', href: `${prefix}/handbuch/instanz/`, soon: false, icon: 'server', tone: 'green' },
    ]
// Die Modulkarten zeigen auf ihre Storybook-Seite; Kanban statt Marktplatz, weil der Marktplatz ein Modul der Netzwerk-App ist, kein Toolkit-Modul.
const m = (key: 'kanban' | 'kanbanDesc' | 'more') => t.modules[key] ?? translations.en.modules[key] ?? ''
const modules: { name: string; desc: string; icon: IconName; tone: Tone; story: string }[] = [
  { name: t.modules.map, desc: t.modules.mapDesc, icon: 'map', tone: 'green', story: 'rls-modules-map--docs' },
  { name: t.modules.calendar, desc: t.modules.calendarDesc, icon: 'calendar', tone: 'blue', story: 'rls-modules-calendar--docs' },
  { name: m('kanban'), desc: m('kanbanDesc'), icon: 'kanban', tone: 'purple', story: 'rls-modules-kanban--docs' },
  { name: t.modules.feed, desc: t.modules.feedDesc, icon: 'message-square', tone: 'orange', story: 'rls-modules-feed--docs' },
]
const waysTitle = de ? 'Loslegen' : 'Get started'
const waysIntro = de ? 'Eine App bauen, einen Agenten losschicken, am Stack mitbauen oder eine Instanz betreiben.' : 'Build an app, send off an agent, contribute to the stack or run an instance.'
const soon = de ? 'folgt' : 'soon'
---
<div class="rl-landing not-content">
  <section class="rl-ways" id="wege">
    <h2>{waysTitle}</h2>
    <p>{waysIntro}</p>
    <div class="rl-cards">
      {ways.map((w) => (
        <a class:list={['rl-card', { soon: w.soon }]} href={w.href}>
          <Icon name={w.icon} tone={w.tone} />
          <strong>{w.title}{w.soon ? ` · ${soon}` : ''}</strong>
          <span>{w.text}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="rl-section" id="module">
    <div>
      <div class="rl-badge">{t.modules.badge}</div>
      <h2>{t.modules.title}</h2>
      <p>{t.modules.p1}</p>
      <p>{t.modules.p2}</p>
    </div>
    <div>
      <div class="rl-cards">
        {modules.map((m) => (
          <a class="rl-card centered" href={`https://real-life-stack.de/storybook/?path=/docs/${m.story}`}>
            <Icon name={m.icon} tone={m.tone} />
            <strong>{m.name}</strong><span>{m.desc}</span>
          </a>
        ))}
      </div>
      <p class="rl-more"><a href="https://real-life-stack.de/storybook/?path=/docs/rls-start-read-me-first--docs">{m('more')} →</a></p>
    </div>
  </section>

  <section class="rl-section flip" id="schnittstelle" style="--rl-accent: var(--rl-blue)">
    <div>
      <div class="rl-badge">{t.dataInterface.badge}</div>
      <h2>{t.dataInterface.title}</h2>
      <p>{t.dataInterface.p1}</p>
      <p>{t.dataInterface.p2}</p>
    </div>
    <div class="rl-list">
      <div><Icon name="users" tone="blue" /><div><strong>{t.dataInterface.groups}</strong><span>{t.dataInterface.groupsDesc}</span></div></div>
      <div><Icon name="calendar" tone="blue" /><div><strong>{t.dataInterface.events}</strong><span>{t.dataInterface.eventsDesc}</span></div></div>
      <div><Icon name="shield" tone="blue" /><div><strong>{t.dataInterface.trust}</strong><span>{t.dataInterface.trustDesc}</span></div></div>
    </div>
  </section>

  <section class="rl-section" id="connectoren" style="--rl-accent: var(--rl-green)">
    <div>
      <div class="rl-badge">{t.connectors.badge}</div>
      <h2>{t.connectors.title}</h2>
      <p>{t.connectors.p1}</p>
      <p>{t.connectors.p2}</p>
    </div>
    <div class="rl-cards three">
      {([
        ['REST', t.connectors.restDesc, 'globe', 'blue'], ['GraphQL', t.connectors.graphqlDesc, 'waypoints', 'purple'], ['Local-first', t.connectors.localDesc, 'hard-drive', 'green'],
        ['P2P', t.connectors.p2pDesc, 'wot', 'orange'], ['E2EE', t.connectors.e2eeDesc, 'lock', 'red'], ['DIDs', t.connectors.didsDesc, 'fingerprint', 'teal'],
      ] as const).map(([name, desc, icon, tone]) => (
        <div class="rl-card compact"><Icon name={icon} tone={tone} tile={false} /><div><strong>{name}</strong><span>{desc}</span></div></div>
      ))}
    </div>
  </section>
</div>
