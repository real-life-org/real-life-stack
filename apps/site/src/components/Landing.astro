---
import { translations, type TranslatedLanguage } from '../i18n/landing'
interface Props { lang: TranslatedLanguage }
const { lang } = Astro.props
const t = translations[lang] ?? translations.en
const prefix = lang === 'de' ? '' : `/${lang}`
const de = lang === 'de'
// Die vier Wege ins Handbuch (Plan 22.09.2026). Deutsch und Englisch; die
// übrigen Sprachen lesen die englische Fassung, bis das Handbuch sie hat.
const ways = de
  ? [
      { title: 'Erste App bauen', text: 'In zehn Minuten eine eigene App auf dem Rahmen: Connector, Register, fertig.', href: '/handbuch/', soon: true },
      { title: 'Mit einem Agenten arbeiten', text: 'Einstiege, Auftragsform und Regeln für Coding-Agents — dieselben Verträge wie für Menschen.', href: '/handbuch/', soon: true },
      { title: 'Am Stack mitbauen', text: 'Entwicklungsumgebung, Spec, Wächter, Review. So wird ein Beitrag zum PR.', href: '/handbuch/', soon: false },
      { title: 'Eine Instanz betreiben', text: 'Die fertige App unter eigenem Namen und eigener Domain für eine Community.', href: '/handbuch/', soon: true },
    ]
  : [
      { title: 'Build a first app', text: 'Your own app on the frame in ten minutes: connector, register, done.', href: `${prefix}/handbuch/`, soon: true },
      { title: 'Work with an agent', text: 'Entry points, task shape and rules for coding agents — the same contracts as for people.', href: `${prefix}/handbuch/`, soon: true },
      { title: 'Contribute to the stack', text: 'Dev environment, spec, guards, review. How a contribution becomes a PR.', href: `${prefix}/handbuch/`, soon: false },
      { title: 'Run an instance', text: 'The finished app under your own name and domain for a community.', href: `${prefix}/handbuch/`, soon: true },
    ]
const waysTitle = de ? 'Vier Wege hinein' : 'Four ways in'
const waysIntro = de ? 'Je nachdem, was du vorhast. Jede Seite des Handbuchs gehört genau einem Weg.' : 'Depending on what you are up to. Every handbook page belongs to exactly one way.'
const soon = de ? 'folgt' : 'soon'
---
<div class="rl-landing">
  <section class="rl-ways" id="wege">
    <h2>{waysTitle}</h2>
    <p>{waysIntro}</p>
    <div class="rl-cards">
      {ways.map((w) => (
        <a class:list={['rl-card', { soon: w.soon }]} href={w.href}>
          <strong>{w.title}{w.soon ? ` · ${soon}` : ''}</strong>
          <span>{w.text}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="rl-section" id="module">
    <div>
      <div class="rl-badge">{t.modules.badge}</div>
      <h2>{t.modules.title}</h2>
      <p>{t.modules.p1}</p>
      <p>{t.modules.p2}</p>
    </div>
    <div class="rl-cards">
      <div class="rl-card"><strong>{t.modules.map}</strong><span>{t.modules.mapDesc}</span></div>
      <div class="rl-card"><strong>{t.modules.calendar}</strong><span>{t.modules.calendarDesc}</span></div>
      <div class="rl-card"><strong>{t.modules.marketplace}</strong><span>{t.modules.marketplaceDesc}</span></div>
      <div class="rl-card"><strong>{t.modules.feed}</strong><span>{t.modules.feedDesc}</span></div>
    </div>
  </section>

  <section class="rl-section flip" id="schnittstelle" style="--rl-accent: var(--rl-blue)">
    <div>
      <div class="rl-badge">{t.dataInterface.badge}</div>
      <h2>{t.dataInterface.title}</h2>
      <p>{t.dataInterface.p1}</p>
      <p>{t.dataInterface.p2}</p>
    </div>
    <div class="rl-list">
      <div><strong>{t.dataInterface.groups}</strong><span>{t.dataInterface.groupsDesc}</span></div>
      <div><strong>{t.dataInterface.events}</strong><span>{t.dataInterface.eventsDesc}</span></div>
      <div><strong>{t.dataInterface.trust}</strong><span>{t.dataInterface.trustDesc}</span></div>
    </div>
  </section>

  <section class="rl-section" id="connectoren" style="--rl-accent: var(--rl-green)">
    <div>
      <div class="rl-badge">{t.connectors.badge}</div>
      <h2>{t.connectors.title}</h2>
      <p>{t.connectors.p1}</p>
      <p>{t.connectors.p2}</p>
    </div>
    <div class="rl-cards three">
      {[
        ['REST', t.connectors.restDesc], ['GraphQL', t.connectors.graphqlDesc], ['Local-first', t.connectors.localDesc],
        ['P2P', t.connectors.p2pDesc], ['E2EE', t.connectors.e2eeDesc], ['DIDs', t.connectors.didsDesc],
      ].map(([name, desc]) => (
        <div class="rl-card compact"><strong>{name}</strong><span>{desc}</span></div>
      ))}
    </div>
  </section>
</div>
