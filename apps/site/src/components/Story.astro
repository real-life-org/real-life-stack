---
/**
 * Eine Story des Toolkits, live im Handbuch. Im Dev-Modus aus dem laufenden Storybook (6006), gebaut aus `/storybook/`.
 *
 * Die Vorschau hat zwei Rahmen: „Desktop“ rendert die App mit 1040px Breite (knapp über dem Panel-Breakpoint) und verkleinert sie auf die Spalte,
 * damit das Seitenpanel wie am Laptop aufgeht; „Handy“ rendert sie 390px breit und verkleinert mit demselben Faktor,
 * damit beide Bilder im gleichen Maßstab stehen. Der Leser
 * schaltet um, die Wahl gilt für alle Vorschauen der Seite und wird im Browser gemerkt.
 * Hell/Dunkel folgt der Site: Starlights `data-theme` wird als Storybook-Global `theme` mitgegeben.
 */
import { storybookBase, storyFrameUrl } from '../lib/story-embed'
interface Props { id: string; title: string; height?: number; frame?: 'desktop' | 'phone' }
const { id, title, height = 560, frame = 'desktop' } = Astro.props
const base = storybookBase()
const url = storyFrameUrl(id)
// Nur die englischen Seiten sind uebersetzt; alle anderen Sprachen zeigen die deutsche Seite und bekommen die deutsche Unterschrift.
const en = Astro.currentLocale === 'en'
const t = en
  ? { open: 'Open in Storybook ↗', note: 'The sample data is fictional. Changes last only for this session.', desktop: 'Desktop', phone: 'Phone' }
  : { open: 'In Storybook öffnen ↗', note: 'Die Beispieldaten sind fiktiv. Änderungen bleiben nur für diese Sitzung.', desktop: 'Desktop', phone: 'Handy' }
---
<figure class="story-example not-content" data-frame={frame} data-height={height}>
  <figcaption>
    <span class="story-frames" role="group">
      <button type="button" data-frame="desktop" aria-pressed={frame === 'desktop'}>{t.desktop}</button>
      <button type="button" data-frame="phone" aria-pressed={frame === 'phone'}>{t.phone}</button>
    </span>
    <a href={`${base}/?path=/story/${id}`}>{t.open}</a>
  </figcaption>
  <div class="story-stage"><div class="story-box"><iframe data-src={url} title={title} loading="lazy" allow="fullscreen"></iframe></div></div>
  <p>{title}. {t.note}</p>
</figure>

<script>
  import '../scripts/story-frames'
</script>
