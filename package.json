{
  "name": "real-life-stack",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "dev:reference": "pnpm --filter reference dev",
    "dev:landing": "pnpm --filter landing dev",
    "dev:network": "pnpm --filter network dev",
    "dev:app": "pnpm --filter @real-life-stack/app dev",
    "build:toolkit": "pnpm --filter @real-life-stack/toolkit build",
    "storybook": "pnpm --filter @real-life-stack/toolkit storybook",
    "test": "turbo test",
    "build:storybook": "pnpm --filter @real-life-stack/toolkit build-storybook",
    "dev:docs": "pnpm --filter @real-life-stack/handbook dev",
    "build:docs": "pnpm --filter @real-life-stack/handbook build",
    "check:docs": "node scripts/handbook/check.mjs",
    "test:docs": "node --test scripts/handbook/check.test.mjs",
    "preview:handbook": "node scripts/handbook/serve.mjs",
    "test:docs:browser": "node scripts/handbook/browser.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "~5.7.2",
    "playwright": "1.63.0"
  }
}
