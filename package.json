{
  "name": "real-life-stack",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "dev:reference": "pnpm --filter reference dev",
    "dev:site": "pnpm --filter @real-life-stack/site dev",
    "build:site": "pnpm --filter @real-life-stack/site build",
    "check:site": "node scripts/site/check.mjs",
    "test:site": "node --test scripts/site/check.test.mjs",
    "preview:site": "node scripts/site/serve.mjs",
    "dev:network": "pnpm --filter network dev",
    "dev:app": "pnpm --filter @real-life-stack/app dev",
    "build:toolkit": "pnpm --filter @real-life-stack/toolkit build",
    "storybook": "pnpm --filter @real-life-stack/toolkit storybook",
    "test": "turbo test",
    "build:storybook": "pnpm --filter @real-life-stack/toolkit build-storybook"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "~5.7.2"
  }
}
