{
  // Renovate für real-life-stack.
  //
  // Die Regeln selbst stehen im gemeinsamen Preset aller real-life-org-Repos:
  // https://github.com/real-life-org/meta/blob/main/renovate/default.json5
  // Kurz: Sicherheits-PRs sofort, unsere eigenen Pakete (`@web_of_trust/**`,
  // `@real-life/**`) sobald sie erscheinen, alles andere als EIN gebündelter
  // PR am Monatsersten, Majors nur nach Freigabe im Dependency-Dashboard.
  // Dort steht auch die allgemeine Begründung (warum überhaupt Renovate,
  // warum nicht jeder Bump als eigener PR).
  //
  // Der Anlass für die WoT-Regel war hier: zwischen dem 30.07. und dem
  // 12.09.2026 kamen neue WoT-Releases nur per Hand-Bump an, einmal davon
  // unbeabsichtigt als Beifang eines fremden PRs (#274). In der Lücke lag
  // wochenlang ein Absturz der Kontaktliste in der App, dessen Fix auf npm
  // längst bereitlag (adapter-yjs 0.2.7, web-of-trust#349).
  //
  // Was hier steht, ist nur das, was real-life-stack vom Preset unterscheidet.
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>real-life-org/meta//renovate/default.json5'],

  // Der PR-Titel wird beim Squash-Merge zum Commit-Betreff auf master und
  // muss durch die Prüfung in `.github/workflows/pr-title.yml` —
  // Conventional Commits, sonst übersieht release-please die Änderung
  // lautlos. `chore(deps): …` erfüllt das.
  semanticCommits: 'enabled',

  // Sicherheits-PRs als `fix(deps)`, aus demselben Grund wie die WoT-Pakete
  // unten: ein geschlossenes Sicherheitsloch in einer Abhängigkeit erreicht
  // Play-Nutzer nur über einen App-Release, und den löst release-please nur
  // bei `fix`, `feat` oder Breaking Change aus.
  //
  // Das Preset schaltet die Sicherheits-PRs ein (`enabled: true`); das Objekt
  // wird zusammengeführt, die beiden Felder kommen hier nur dazu.
  vulnerabilityAlerts: {
    semanticCommitType: 'fix',
    semanticCommitScope: 'deps',
  },

  packageRules: [
    {
      // Die Pakete hängen als npm-Alias in der package.json
      // (`npm:@web_of_trust/adapter-yjs@^0.2.9`). Renovate matcht auf den
      // echten Paketnamen hinter dem Alias, nicht auf den Alias-Schlüssel —
      // deshalb greift die Preset-Regel für `@web_of_trust/**` (sofort, ein
      // gemeinsamer PR, `rangeStrategy: bump`) auch hier, und diese hier
      // ergänzt nur den Commit-Typ.
      matchPackageNames: ['@web_of_trust/**'],

      // `fix`, nicht `chore` — das ist hier keine Kosmetik am Changelog.
      //
      // Play hat bewusst kein OTA (Google verbietet Self-Updates ausserhalb
      // seines Mechanismus, siehe `scripts/release/test-release-cascade.mjs`).
      // Ein Fix in einer dieser Abhängigkeiten erreicht Play also NUR über
      // einen App-Release, und den löst release-please allein bei `fix`,
      // `feat` oder Breaking Change aus. Ein `chore(deps)`-Bump landete auf
      // master und bliebe dort liegen, bis zufällig etwas anderes released
      // wird — bei Play-Nutzern käme er bis dahin nicht an.
      //
      // Renovate kann nicht wissen, was in einem Release steckt. Der Default
      // muss darum der teurere Fall sein: adapter-yjs 0.2.7 trug den Fix
      // gegen den Absturz der Kontaktliste und wäre unter `chore` genauso
      // liegengeblieben wie er es ohnehin schon vier Wochen lang war. Ein
      // überflüssiger Patch-Release kostet nichts; ein nicht ausgelieferter
      // Fix kostet Nutzer.
      //
      // Umgekehrt gilt: ein Bump, der nachweislich nur Features enthält, die
      // wir nicht benutzen, darf von Hand auf `chore` zurückgestuft werden —
      // das ist eine Aussage über diesen einen Release, keine Regel.
      //
      // Der monatliche Sammel-PR bleibt dagegen bei `chore(deps)`: er ist
      // Wartung ohne bekannten Fix für Nutzer und geht mit dem nächsten
      // Release ohnehin mit raus.
      semanticCommitType: 'fix',
      semanticCommitScope: 'deps',
    },
  ],
}
