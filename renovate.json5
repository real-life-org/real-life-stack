{
  // Renovate öffnet Bump-PRs für die WoT-Pakete — und NUR für die.
  //
  // Warum überhaupt: `pnpm install --frozen-lockfile` läuft in jedem Job
  // (tests, publish, deploy-prototypes). Die Range `^0.2.9` in der
  // package.json wird dabei nie neu aufgelöst — es gilt ausschliesslich,
  // was in der Lockfile steht. Ein neues Release auf npm erreicht uns also
  // nur, wenn jemand den Bump von Hand macht. Zwischen dem 30.07. und dem
  // 12.09.2026 ist das zweimal passiert, davon einmal unbeabsichtigt als
  // Beifang eines fremden PRs (#274). In der Lücke lag wochenlang ein
  // Absturz der Kontaktliste in der App, dessen Fix auf npm längst
  // bereitlag (adapter-yjs 0.2.7, web-of-trust#349).
  //
  // Bewusst nur die WoT-Pakete: der Rest des Baums (React, Vite, Storybook,
  // Capacitor …) wird weiter von Hand bewegt. Alles auf einmal zu öffnen
  // erzeugt eine PR-Flut, die niemand liest — und ungelesene Bump-PRs sind
  // schlechter als keine, weil sie den Eindruck erwecken, das Thema sei
  // versorgt.
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Eine Übersichts-Issue statt stiller Arbeit: was Renovate sieht und
  // warum es nichts tut, steht dort nachlesbar.
  dependencyDashboard: true,

  // Der PR-Titel wird beim Squash-Merge zum Commit-Betreff auf master und
  // muss durch die Prüfung in `.github/workflows/pr-title.yml` —
  // Conventional Commits, sonst übersieht release-please die Änderung
  // lautlos. `chore(deps): …` erfüllt das.
  semanticCommits: 'enabled',

  packageRules: [
    // Erst alles aus, dann gezielt eines an. Andersherum (nur eine
    // Positiv-Regel) bliebe der Standard für alle übrigen Pakete aktiv.
    {
      matchPackageNames: ['*'],
      enabled: false,
    },
    {
      // Die Pakete hängen als npm-Alias in der package.json
      // (`npm:@web_of_trust/adapter-yjs@^0.2.9`). Renovate matcht auf den
      // echten Paketnamen hinter dem Alias, nicht auf den Alias-Schlüssel.
      matchPackageNames: ['@web_of_trust/**'],
      enabled: true,

      // Ein PR für beide. adapter-yjs verlangt core als Peer in exakt
      // passender Minor (0.2.9 → `^0.5.9`); einzeln geöffnet wäre jeder
      // der beiden PRs für sich rot.
      groupName: 'WoT-Pakete',

      // `fix`, nicht `chore` — das ist hier keine Kosmetik am Changelog.
      //
      // Play hat bewusst kein OTA (Google verbietet Self-Updates ausserhalb
      // seines Mechanismus, siehe `scripts/release/test-release-cascade.mjs`).
      // Ein Fix in einer dieser Abhängigkeiten erreicht Play also NUR über
      // einen App-Release, und den löst release-please allein bei `fix`,
      // `feat` oder Breaking Change aus. Ein `chore(deps)`-Bump landete auf
      // master und bliebe dort liegen, bis zufällig etwas anderes released
      // wird — bei Play-Nutzern käme er bis dahin nicht an.
      //
      // Renovate kann nicht wissen, was in einem Release steckt. Der Default
      // muss darum der teurere Fall sein: adapter-yjs 0.2.7 trug den Fix
      // gegen den Absturz der Kontaktliste und wäre unter `chore` genauso
      // liegengeblieben wie er es ohnehin schon vier Wochen lang war. Ein
      // überflüssiger Patch-Release kostet nichts; ein nicht ausgelieferter
      // Fix kostet Nutzer.
      //
      // Umgekehrt gilt: ein Bump, der nachweislich nur Features enthält, die
      // wir nicht benutzen, darf von Hand auf `chore` zurückgestuft werden —
      // das ist eine Aussage über diesen einen Release, keine Regel.
      semanticCommitType: 'fix',
      semanticCommitScope: 'deps',

      // Die Range in der package.json mitziehen, nicht nur die Lockfile.
      // Sonst driftet die veröffentlichte Angabe von dem weg, was wir
      // tatsächlich testen: wir liefern `^0.2.5` aus und prüfen 0.2.9 —
      // jeder, der unsere Pakete frisch installiert, bekommt eine
      // Kombination, die hier nie gelaufen ist.
      rangeStrategy: 'bump',
    },
    {
      // Renovate haelt seinen eigenen Runner aktuell.
      //
      // `.github/workflows/renovate.yml` pinnt die Action auf einen
      // Commit-SHA (das Repo hat keine mitlaufenden Major-Tags, und ein Tag
      // liesse sich umhaengen). Ein gepinnter SHA veraltet, und niemand
      // merkt es: der Lauf bleibt gruen, bis die Version irgendwann an einer
      // Registry-Aenderung zerbricht. Genau die Klasse Fehler, gegen die
      // dieser ganze PR antritt — also soll der Bot auch sich selbst
      // nachziehen. Renovate hebt SHA und den Versionskommentar dahinter
      // gemeinsam an.
      //
      // PREIS: der Token braucht dafuer `Workflows: read+write`. GitHub weist
      // jeden Push zurueck, der `.github/workflows/` aendert, wenn das Recht
      // fehlt. Es ist das maechtigste der vier Rechte — mit ihm kann der Bot
      // jede CI-Datei umschreiben. Wem das zu weit geht, streicht diese Regel
      // und bewegt den Pin von Hand; dann reichen Contents, Pull requests und
      // Issues.
      matchManagers: ['github-actions'],
      matchDepNames: ['renovatebot/github-action'],
      enabled: true,

      // `ci`, nicht `fix`: eine neue Runner-Version aendert nichts an dem,
      // was die App tut. release-please ignoriert `ci` — hier ist das
      // richtig, waehrend es bei den WoT-Paketen oben falsch waere.
      semanticCommitType: 'ci',
      semanticCommitScope: 'renovate',
    },
  ],
}
